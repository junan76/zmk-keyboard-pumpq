/dts-v1/;
#include <st/f4/stm32f407Xe.dtsi>
#include <st/f4/stm32f407v(e-g)tx-pinctrl.dtsi>

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
	model = "Pumpq Skystar";
	compatible = "pumpq,skystar";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zmk,kscan = &kscan0;
		zmk,physical-layout = &layout_pumpq_4x4_all1u;
	};

	kscan0: kscan0 {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";
		row-gpios = <&gpioc 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
					<&gpioc 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
					<&gpioc 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
					<&gpioc 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		col-gpios = <&gpioa 2 GPIO_ACTIVE_HIGH>,
					<&gpioa 0 GPIO_ACTIVE_HIGH>,
					<&gpioa 4 GPIO_ACTIVE_HIGH>,
					<&gpioa 6 GPIO_ACTIVE_HIGH>;
	};

	layout_grid_transform:
	keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <4>;
		rows = <4>;
		map = <RC(0,0) RC(0,1) RC(0,2) RC(0,3)
			   RC(1,0) RC(1,1) RC(1,2) RC(1,3)
			   RC(2,0) RC(2,1) RC(2,2) RC(2,3)
			   RC(3,0) RC(3,1) RC(3,2) RC(3,3)>;
	};

	layout_pumpq_4x4_all1u: layout_pumpq_4x4_all1u {
		compatible = "zmk,physical-layout";
		display-name = "4x4 All 1U/Grid";
		transform = <&layout_grid_transform>;

		keys //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100 0 0 0 0 0>,
			   <&key_physical_attrs 100 100 100 0 0 0 0>,
			   <&key_physical_attrs 100 100 200 0 0 0 0>,
			   <&key_physical_attrs 100 100 300 0 0 0 0>,
			   <&key_physical_attrs 100 100 0 100 0 0 0>,
			   <&key_physical_attrs 100 100 100 100 0 0 0>,
			   <&key_physical_attrs 100 100 200 100 0 0 0>,
			   <&key_physical_attrs 100 100 300 100 0 0 0>,
			   <&key_physical_attrs 100 100 0 200 0 0 0>,
			   <&key_physical_attrs 100 100 100 200 0 0 0>,
			   <&key_physical_attrs 100 100 200 200 0 0 0>,
			   <&key_physical_attrs 100 100 300 200 0 0 0>,
			   <&key_physical_attrs 100 100 0 300 0 0 0>,
			   <&key_physical_attrs 100 100 100 300 0 0 0>,
			   <&key_physical_attrs 100 100 200 300 0 0 0>,
			   <&key_physical_attrs 100 100 300 300 0 0 0>;
	};
};

&clk_hse {
	status = "okay";
	clock-frequency = <DT_FREQ_M(8)>;
};

&pll {
	div-m = <8>;
	mul-n = <336>;
	div-p = <2>;      /* 168 MHz */
	div-q = <7>;      /* 48 MHz for USB */
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(168)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <4>;   /* 42 MHz, APB1 上限 */
	apb2-prescaler = <2>;   /* 84 MHz, APB2 上限 */
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};
